# ============================================================
# ROS2 Workspace .gitignore
# Covers: C++, Python, Colcon, Gazebo, RViz, and general dev
# ============================================================


# ------------------------------------------------------------
# ROS2 Colcon Build Artifacts
# Generated by 'colcon build' — rebuilt on each machine
# ------------------------------------------------------------
build/
install/
log/
.colcon_install_layout


# ------------------------------------------------------------
# ROS2 Python Package Artifacts
# Generated by Python packaging tools and ament_python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
.eggs/
MANIFEST
pip-wheel-metadata/


# ------------------------------------------------------------
# ROS2 C++ Build Artifacts
# Note: most of these live in build/ or install/ already.
# The global patterns below are defensive only.
# *.cmake intentionally NOT globally ignored — it can catch
# legitimate custom cmake/ modules in package source.
# ------------------------------------------------------------
*.a
*.so
*.o
*.out


# ------------------------------------------------------------
# Gazebo Simulation Files
# Logs, recordings, and cache from simulation runs
# ------------------------------------------------------------
.gazebo/
gazebo_logs/
*.bag
*.bag.active
*.db3
*.db3-shm
*.db3-wal


# ------------------------------------------------------------
# RViz
# Keep tracked .rviz config files, ignore temp/backup ones
# ------------------------------------------------------------
*.rviz~


# ------------------------------------------------------------
# IDE and Editor Files
# ------------------------------------------------------------

# VS Code (including the huge C++ IntelliSense databases
# at any depth — these are what exceeded GitHub's size limit)
.vscode/
**/.vscode/
*.vc.db
*.code-workspace

# CLion / JetBrains
.idea/
cmake-build-*/
*.iml

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
\#*\#
.\#*


# ------------------------------------------------------------
# Environment and Secrets
# NEVER commit API keys, credentials, or env configs
# ------------------------------------------------------------
.env
.env.*
*.env
secrets.yaml
secrets.yml
credentials.json
*.pem
*.key
*.cert
*.p12
config/secrets/
params/secrets/


# ------------------------------------------------------------
# ROS2 Parameter Files With Sensitive / Local Data
# Keeps generic param files, ignores local overrides
# ------------------------------------------------------------
*_local.yaml
*_private.yaml
*_secret.yaml
local_params/


# ------------------------------------------------------------
# rosdep Artifacts
# ------------------------------------------------------------
.rosdep/


# ------------------------------------------------------------
# Python Virtual Environments
# ------------------------------------------------------------
venv/
.venv/
env/
ENV/


# ------------------------------------------------------------
# OS Generated Files
# ------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*


# ------------------------------------------------------------
# Compiled Documentation
# ------------------------------------------------------------
docs/_build/
docs/html/
doxygen_output/


# ------------------------------------------------------------
# Test and Coverage Artifacts
# ------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
test-results/
*.lcov


# ------------------------------------------------------------
# Temporary and Backup Files
# ------------------------------------------------------------
*.tmp
*.temp
*.bak
*.orig
*.rej
